# SciAtlas frontend runtime configuration
SCIATLAS_API_BASE_URL=http://sciatlas.openkg.cn
SCIATLAS_API_KEY=your-personal-sciatlas-token
SCIATLAS_TIMEOUT=900
SCIATLAS_RUNS_DIR=./runs

# Optional: dedicated downstream workflows.
# Used by literature_review_pipeline, review_pipeline, and sciatlas_idea_gen.
# Hosted mode uses this repository's run_sciatlas.py as the retrieval adapter.
SCIATLAS_WORKFLOW_ENV=.env
SCIATLAS_OFFICIAL_CLI_ROOT=.
SCIATLAS_CACHE_DIR=./runs/cache

# Set to 1 only when you have a local Neo4j+embedding KG configured for
# references/search/run_search.py. Hosted mode should leave this at 0.
SCIATLAS_USE_LOCAL_KG=0
SCIATLAS_LOCAL_SEARCH_ROOT=./references/search
SCIATLAS_MAX_RETRIES=4
SCIATLAS_RETRY_BACKOFF=5.0

# Optional: LLM-assisted frontend keyword extraction and downstream workflows.
# Also required for workflow stages that generate reviews, rubrics, or ideas.
# Works with any provider or gateway that exposes a Chat Completions-compatible API.
# Preferred names are LLM_*; SCIATLAS_LLM_*, SEARCH_LLM_*, OPENAI_*, and legacy
# DMX aliases are also accepted by the CLI/workflow where applicable.
LLM_PROVIDER=chat_completions
LLM_API_KEY=
LLM_BASE_URL=https://your-llm-provider.example/v1
LLM_API_URL=
LLM_CHAT_COMPLETIONS_URL=
LLM_MODEL=your-model-name
LLM_AUTH_HEADER=
LLM_HTTP_HEADERS=
LLM_TIMEOUT=180
LLM_TEMPERATURE=0.7
LLM_MAX_RETRIES=4
LLM_MAX_TOKENS=512
# Optional aliases for older setups; leave commented unless you need them.
# SCIATLAS_LLM_API_KEY=
# SCIATLAS_LLM_BASE_URL=
# SCIATLAS_LLM_MODEL=
# SCIATLAS_LLM_TIMEOUT=
# SCIATLAS_LLM_TEMPERATURE=
# SCIATLAS_LLM_MAX_RETRIES=
# SCIATLAS_LLM_MAX_TOKENS=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
# SEARCH_LLM_API_KEY=
# SEARCH_LLM_API_URL=
# SEARCH_LLM_MODEL=
# DMX_API_KEY=

# Optional: Semantic Scholar enrichment for workflow search stages.
S2_API_KEY=

# PDF-only workflows.
GROBID_BASE_URL=http://127.0.0.1:8070

# Optional: OpenAlex fallback/enrichment.
OA_API_KEY=
OPENALEX_MAILTO=
